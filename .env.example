# Supabase — valores públicos (anon/publishable key apenas)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLOQUE_A_CHAVE_ANON_PUBLICA_DO_SUPABASE

# Caminho base da SPA (deve coincidir com RewriteBase no .htaccess do servidor)
# Produção: /plataforma/   Dev local: / (ou omitir — Vite usa / por padrão no dev)
VITE_BASE_PATH=/plataforma/

# API PHP de upload de áudio (hospedada na Hostinger / netpubli.com.br por enquanto)
VITE_AUDIO_UPLOAD_URL=https://netpubli.com.br/api-academia/upload-audio.php

# URL base dos ficheiros de média (MP3, etc.) servidos pela Hostinger
VITE_MEDIA_BASE_URL=https://netpubli.com.br/media-academia/

# NUNCA coloque aqui: service_role, OPENAI_API_KEY, GROQ_API_KEY nem quaisquer segredos.
# Segredos do OpenAI/Groq pertencem a supabase/functions/.env (local)
# ou aos secrets das Edge Functions no dashboard do Supabase (produção).
